// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  name             String
  phone            String?   // For SMS / Kakao
  marketingConsent Boolean   @default(false)
  kakaoId          String?   // Optional Kakao Sync
  role             String    @default("USER") // "USER" or "ADMIN"
  createdAt        DateTime  @default(now())

  loginId          String?   @unique
  birthDate        String?   // Birthdate e.g., "1995-05-12"
  address          String?   // User delivery / address
  realNameVerified Boolean   @default(false) // KCB / PASS verification state
  socialProvider   String?   // "GOOGLE", "NAVER", "KAKAO", null
  socialId         String?   // provider user id
  
  // Performance & Affiliate
  totalPurchases   Int       @default(0) // Total amount purchased by the user
  referralPoints   Int       @default(0) // Points earned from referrals
  referralCode     String    @unique @default(uuid()) // Their own code to share
  referredById     String?   // The user who referred them
  
  // Relations
  orders           Order[]
  posts            Post[]    @relation("UserPosts")
  referredUsers    User[]    @relation("Referrals")
  referrer         User?     @relation("Referrals", fields: [referredById], references: [id])
  reviews          Review[]
  questions        Question[]
  messageLogs      MessageLog[]
  cartItems        CartItem[]
  wishlist         Wishlist[]
}

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String   // Rich text or Markdown
  type      String   // "ABOUT" or "PRODUCT" or "JOURNAL"
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  authorId  String
  author    User     @relation("UserPosts", fields: [authorId], references: [id])
}

model GuidePost {
  id           String    @id @default(uuid())
  title        String
  category     String    @default("주방") // "주방", "욕실", "리빙/가구", "유리/거울", "다목적", "기타"
  summary      String?
  content      String    // Detailed step-by-step cleaning guide
  thumbnailUrl String?
  images       String?   // JSON array of step photos: '["/uploads/...", ...]'
  tips         String?   // Pro tips or caution
  viewCount    Int       @default(0)
  published    Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  productId    String?
  product      Product?  @relation(fields: [productId], references: [id])
}

model Promotion {
  id           String    @id @default(uuid())
  title        String
  subtitle     String?
  badgeText    String    @default("SPECIAL EVENT")
  discountText String?   // e.g. "최대 30% 할인 + 신규 3,000P"
  content      String?
  imageUrl     String?
  linkUrl      String?   @default("/shop")
  buttonText   String?   @default("이벤트 혜택 받기")
  startDate    DateTime  @default(now())
  endDate      DateTime? // Event end date
  isActive     Boolean   @default(true)
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Order {
  id             String   @id @default(uuid())
  totalAmount    Int
  status         String   @default("COMPLETED") // "PENDING", "COMPLETED", "CANCELLED"
  shippingMethod String   @default("일반택배")
  shippingFee    Int      @default(3000)
  optionSelected String   @default("기본 패키지 단품")
  createdAt      DateTime @default(now())
  
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
}

model Policy {
  id                 String   @id @default(uuid())
  key                String   @unique // e.g., "REFERRAL_REWARD_PERCENTAGE", "VIP_THRESHOLD"
  value              String   // e.g., "5", "500000"
  description        String?
  updatedAt          DateTime @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  rating    Int      // 1 to 5
  content   String
  comment   String?  // Admin response/reply comment
  createdAt DateTime @default(now())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
}

model Question {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String   @default("일반") // "상품", "배송", "교환/반품", "기타"
  isSecret  Boolean  @default(false)
  answer    String?
  createdAt DateTime @default(now())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
}

model MessageLog {
  id        String   @id @default(uuid())
  type      String   // "SMS", "EMAIL", "KAKAO"
  content   String
  status    String   // "SUCCESS", "FAILED"
  createdAt DateTime @default(now())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Product {
  id            String   @id @default(uuid())
  name          String
  description   String
  category      String   @default("세정제류") // 1st Depth 대분류: "세정제류", "탈취제류", "소독·살균제류", "세탁·섬유케어", "기타·액세서리"
  subCategory   String?  @default("다목적/올인원") // 2nd Depth 중/소분류(용처별): "다목적/올인원", "주방/기름때", "욕실/물때", "유리/거울", "바닥/타일" 등
  price         Int      // Selling/Discount price
  originalPrice Int?     // Original regular price
  shippingFee   Int      @default(3000) // Shipping fee
  imageUrl      String   // Main primary image
  images        String?  // JSON array of multiple image URLs: '["url1", "url2"]'
  detailContent String?  // Detailed HTML / rich explanation
  detailImages  String?  // JSON array of detail image URLs
  options       String?  // JSON array of options: '[{"id": "...", "name": "기본 패키지 단품", "extraPrice": 0, "stock": 100}]'
  stock         Int      @default(100)
  safetyStock   Int      @default(10)
  isVisible     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders        Order[]
  cartItems     CartItem[]
  wishlist      Wishlist[]
  reviews       Review[]
  questions     Question[]
  inventoryLogs InventoryLog[]
  guidePosts    GuidePost[]
}

model InventoryLog {
  id               String    @id @default(uuid())
  productId        String?
  product          Product?  @relation(fields: [productId], references: [id])
  type             String    // "IN", "OUT", "ADJUST"
  quantity         Int       // Change quantity
  balance          Int       // Final stock balance
  reason           String    // Reason (e.g., "자사몰 주문 출고", "네이버 스마트스토어 차감", "B2B 도매 출고", "본사 수기 입고")
  createdAt        DateTime  @default(now())

  // ERP & Tax Integration Fields
  partnerId        String?
  partnerName      String?   // Snapshot partner name (e.g. "네이버 스마트스토어", "쿠팡", "(주)한국보틀")
  channelType      String?   // "NAVER", "COUPANG", "ZASAMALL", "OFFLINE", "B2B", "SUPPLIER"
  taxInvoiceStatus String?   @default("NOT_APPLICABLE") // "ISSUED", "UNISSUED", "EXEMPT", "NOT_APPLICABLE"
  taxInvoiceNumber String?   // Electronic Tax Invoice Approval No. (e.g. 20260822-41000001-...)
  taxInvoiceDate   DateTime?
  unitPrice        Int?      // Selling or purchase price per unit
  totalAmount      Int?      // Total transaction amount
  vatIncluded      Boolean   @default(true)
  memo             String?
}

model Partner {
  id          String   @id @default(uuid())
  name        String   // 거래처명 (예: 네이버 스마트스토어, 쿠팡 윙, 성수동 팝업, (주)한국보틀, (주)그린케미칼)
  type        String   @default("SALES") // "SALES"(매출처), "PURCHASE"(매입처), "BOTH"(매출/매입 공통)
  channelType String   @default("ONLINE_MALL") // "ONLINE_MALL", "OFFLINE_STORE", "B2B_WHOLESALE", "RAW_MATERIAL", "MANUFACTURER", "OTHER"
  bizNumber   String?  // 사업자등록번호
  ceoName     String?  // 대표자명
  contact     String?  // 담당자 연락처
  email       String?  // 세금계산서 수신 이메일
  address     String?  // 소재지
  memo        String?  // 비고 / 정산 주기 메모
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChannelOrder {
  id               String    @id @default(uuid())
  channel          String    @default("NAVER") // "NAVER", "COUPANG", "ZASAMALL", "OFFLINE", "B2B"
  channelOrderNo   String?   // 외부몰 주문번호 (예: 20260822123456)
  productName      String    // 주문 상품명
  productId        String?   // 매핑된 퍼베이드 상품 ID (옵션)
  quantity         Int       @default(1)
  unitPrice        Int       @default(0)
  totalPrice       Int       @default(0)
  buyerName        String    // 구매자명 / 주문자
  buyerPhone       String?   // 연락처
  receiverName     String?   // 수령인
  receiverPhone    String?   // 수령인 연락처
  shippingAddress  String?   // 배송지 주소
  shippingMsg      String?   // 배송 메시지
  shippingCarrier  String    @default("CJ대한통운") // 택배사
  trackingNumber   String?   // 운송장번호
  status           String    @default("PAID") // "PAID"(결제완료), "PREPARING"(배송준비), "SHIPPED"(배송중), "DELIVERED"(배송완료), "CANCELLED"(취소)
  taxInvoiceStatus String    @default("UNISSUED") // "ISSUED", "UNISSUED", "EXEMPT", "CASH_RECEIPT"
  taxInvoiceNumber String?   // 세금계산서 승인번호
  orderDate        DateTime  @default(now())
  shippedDate      DateTime?
  memo             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model RawMaterial {
  id           String   @id @default(uuid())
  name         String   // 부자재/원료명 (예: 500ml 친환경 용기, 프리미엄 미세안개 스프레이건, 코코넛 천연계면활성제 원료, 1000ml 에코 파우치)
  category     String   @default("CONTAINER") // "CONTAINER"(용기/공병), "SPRAY"(스프레이/캡), "RAW_INGREDIENT"(원료/액상), "PACKAGE"(단상자/박스), "LABEL"(라벨/스티커), "OTHER"
  unit         String   @default("개") // "개", "kg", "L", "롤", "박스"
  currentStock Int      @default(0)
  safetyStock  Int      @default(100)
  unitCost     Int      @default(0) // 표준 매입 단가
  supplierId   String?  // 매입처 거래처 ID
  supplierName String?  // 매입처명 (예: (주)한국보틀)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Content {
  id        String   @id @default(uuid())
  category  String   // "FAQ", "GUIDE", "SHIPPING", "TERMS", "PRIVACY"
  title     String
  body      String
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id             String   @id @default(uuid())
  userId         String
  productId      String
  optionSelected String   @default("기본 패키지 단품")
  shippingMethod String   @default("일반택배")
  quantity       Int      @default(1)
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id])
  product        Product  @relation(fields: [productId], references: [id])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model SiteLog {
  id        String   @id @default(uuid())
  path      String   // e.g. "/", "/shop", "/products", "/guide"
  referrer  String?  // e.g. "naver.com", "instagram.com", "google.com", "Direct"
  device    String   @default("Desktop") // "Mobile", "Desktop", "Tablet"
  browser   String   @default("Chrome") // "Chrome", "Safari", "Whale", "Edge", "Other"
  ip        String?  // Anonymized IP hash
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([referrer])
}

