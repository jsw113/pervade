# ==========================================
# Application Environment Variables Template
# ==========================================

# Database Connection (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql://username:password@localhost:5432/mydb?sslmode=require"

# Super Admin Initial Credentials
ADMIN_LOGIN_ID="admin"
ADMIN_PASSWORD="your_secure_admin_password!"

# NextAuth / JWT Secret
JWT_SECRET="your_random_jwt_secret_key"
NEXTAUTH_SECRET="your_random_nextauth_secret_key"

# Toss Payments (결제 연동)
TOSS_CLIENT_KEY="test_ck_..."
TOSS_SECRET_KEY="test_sk_..."

# Naver Login (네이버 소셜 로그인)
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
NEXT_PUBLIC_NAVER_REDIRECT_URI="http://localhost:3000/api/auth/callback/naver"

# Kakao Login (카카오 소셜 로그인)
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
NEXT_PUBLIC_KAKAO_REDIRECT_URI="http://localhost:3000/api/auth/callback/kakao"

# Google Login (구글 소셜 로그인)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"
